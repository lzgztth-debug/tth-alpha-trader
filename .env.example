# ============================================================
# AlphaTrader - 环境变量示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 应用配置 ----
APP_NAME=AlphaTrader
APP_VERSION=5.0.0
DEBUG=false
CONFIG_PATH=config/config.yaml

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_ENABLED=false

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096

# ---- DashScope (通义千问) ----
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_TEMPERATURE=0.7

# ---- Seed (豆包) ----
SEED_API_KEY=your-seed-api-key-here
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEED_MODEL=doubao-pro-32k
SEED_TEMPERATURE=0.7

# ---- MiniMax ----
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_TEMPERATURE=0.7

# ---- SiliconFlow (硅基流动) ----
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_TEMPERATURE=0.7

# ---- Zhipu (智谱 GLM) ----
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4
ZHIPU_TEMPERATURE=0.7

# ---- Qianfan (千帆/百度文心) ----
QIANFAN_API_KEY=your-qianfan-api-key-here
QIANFAN_SECRET_KEY=your-qianfan-secret-key-here
QIANFAN_BASE_URL=https://aip.baidubce.com
QIANFAN_MODEL=ernie-bot-4
QIANFAN_TEMPERATURE=0.7

# ---- Moonshot (月之暗面/Kimi) ----
MOONSHOT_API_KEY=your-moonshot-api-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_TEMPERATURE=0.7

# ---- AI通用 ----
AI_DEFAULT_PROVIDER=openai
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_DELAY=1.0

# ---- 券商配置 ----
BROKER_DEFAULT=simulated
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_PASSPHRASE=
BROKER_BASE_URL=
BROKER_SANDBOX=true
BROKER_RATE_LIMIT=10

# ---- 交易模式 ----
TRADING_MODE=paper
MAX_POSITION_SIZE=10000.0
MAX_DAILY_TRADES=50
MAX_DRAWDOWN_PCT=5.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=5.0
RISK_PER_TRADE_PCT=1.0
ALLOWED_SYMBOLS=
TIMEZONE=Asia/Shanghai

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE=trading.log
LOG_ROTATION=00:00
LOG_RETENTION=30 days
LOG_CONSOLE_OUTPUT=true
LOG_FILE_OUTPUT=true

# ---- API服务 ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000","http://localhost:5173"]
API_KEY_ENABLED=true
API_KEY=

# ---- JWT认证 ----
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- 加密 ----
ENCRYPTION_KEY=your-base64-encoded-fernet-key-here
